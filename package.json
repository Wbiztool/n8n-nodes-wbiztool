{
  "name": "n8n-nodes-wbiztool",
  "version": "0.2.0",
  "description": "WbizTool node for n8n: send WhatsApp messages, files and group messages from your own number, schedule and track them.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "wbiztool",
    "whatsapp",
    "messaging",
    "automation",
    "workflow"
  ],
  "license": "MIT",
  "homepage": "https://github.com/wbiztool/n8n-nodes-wbiztool",
  "author": {
    "name": "WbizTool Team",
    "email": "support@wbiztool.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbiztool/n8n-nodes-wbiztool.git"
  },
  "bugs": {
    "url": "https://github.com/wbiztool/n8n-nodes-wbiztool/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WbizToolApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WbizTool/WbizToolSendMessage.node.js",
      "dist/nodes/WbizTool/WbizToolSendGroupMessage.node.js",
      "dist/nodes/WbizTool/WbizToolSendMultiMessage.node.js",
      "dist/nodes/WbizTool/WbizToolScheduleMessage.node.js",
      "dist/nodes/WbizTool/WbizToolCancelMessage.node.js",
      "dist/nodes/WbizTool/WbizToolMessageStatus.node.js",
      "dist/nodes/WbizTool/WbizToolCheckCredentials.node.js",
      "dist/nodes/WbizTool/WbizToolListWhatsAppClients.node.js",
      "dist/nodes/WbizTool/WbizToolCreateWhatsAppClient.node.js",
      "dist/nodes/WbizTool/WbizToolWhatsAppClientStatus.node.js"
    ],
    "strict": true
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.52.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "axios": "^1.10.0",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
