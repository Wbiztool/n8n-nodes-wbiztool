{
  "name": "n8n-nodes-wbiztool",
  "version": "0.1.2",
  "description": "n8n nodes for WbizTool WhatsApp Business Automation Platform integration",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "wbiztool",
    "whatsapp",
    "messaging",
    "automation",
    "workflow"
  ],
  "license": "MIT",
  "homepage": "https://github.com/wbiztool/n8n-nodes-wbiztool",
  "author": {
    "name": "WbizTool Team",
    "email": "support@wbiztool.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbiztool/n8n-nodes-wbiztool.git"
  },
  "bugs": {
    "url": "https://github.com/wbiztool/n8n-nodes-wbiztool/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials --ext .ts,.js",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "files": [
    "dist",
    "credentials",
    "nodes"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WbizToolApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WbizTool/WbizToolSendMessage.node.js",
      "dist/nodes/WbizTool/WbizToolSendGroupMessage.node.js",
      "dist/nodes/WbizTool/WbizToolSendMultiMessage.node.js",
      "dist/nodes/WbizTool/WbizToolScheduleMessage.node.js",
      "dist/nodes/WbizTool/WbizToolCancelMessage.node.js",
      "dist/nodes/WbizTool/WbizToolMessageStatus.node.js",
      "dist/nodes/WbizTool/WbizToolCheckCredentials.node.js",
      "dist/nodes/WbizTool/WbizToolListWhatsAppClients.node.js",
      "dist/nodes/WbizTool/WbizToolCreateWhatsAppClient.node.js",
      "dist/nodes/WbizTool/WbizToolWhatsAppClientStatus.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "axios": "^1.10.0",
    "eslint": "^8.57.1",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "form-data": "^4.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/nodes",
      "<rootDir>/credentials"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "nodes/**/*.ts",
      "credentials/**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ]
  }
}
